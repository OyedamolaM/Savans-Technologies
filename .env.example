VITE_GA_MEASUREMENT_ID=
VITE_PLAUSIBLE_DOMAIN=
SITE_URL=https://savanstech.com

# Supabase project settings. Keep the service-role key server-only: do not prefix it with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: send contact form leads to Zapier, Make, Google Apps Script, Airtable, Notion, or a CRM webhook.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# Paystack server secret key. Set Paystack dashboard webhook URL to
# https://your-domain/api/paystack/webhook so charge.success events are verified.
PAYSTACK_SECRET_KEY=

# Admin login for /payments. Open /savansadminlogin. Use a unique, long password.
ADMIN_EMAIL=admin@savanstech.com
ADMIN_PASSWORD=

# Email notifications for successful payments and customer receipts.
# If SMTP_* is set, the app sends through that SMTP server.
# Otherwise set BREVO_API_KEY to send through Brevo.
NOTIFICATION_EMAIL_TO=oyedamola@savanstech.com
EMAIL_FROM=Savans Technologies <hello@savanstech.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
BREVO_API_KEY=
RESEND_API_KEY=
